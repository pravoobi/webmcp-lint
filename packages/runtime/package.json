{
  "name": "@webmcp-lint/runtime",
  "version": "0.1.0",
  "description": "Playwright runtime harness: loads pages with the WebMCP polyfill and inspects what registers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@webmcp-lint/rules": "workspace:*",
    "@mcp-b/webmcp-polyfill": "^5.1.0",
    "playwright": "^1.48.0"
  },
  "peerDependenciesMeta": {},
  "engines": {
    "node": ">=20"
  }
}
