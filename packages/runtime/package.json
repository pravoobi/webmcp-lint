{
  "name": "@pravoobi/webmcp-lint-runtime",
  "version": "0.2.1",
  "description": "Playwright runtime harness: loads pages with the WebMCP polyfill and inspects what registers",
  "type": "module",
  "license": "MIT",
  "author": "Venkata Praveen Velisetty",
  "keywords": ["webmcp", "mcp", "linter", "playwright", "runtime"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pravoobi/webmcp-lint.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/pravoobi/webmcp-lint#readme",
  "bugs": {
    "url": "https://github.com/pravoobi/webmcp-lint/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pravoobi/webmcp-lint-rules": "workspace:*",
    "@mcp-b/webmcp-polyfill": "^5.1.0",
    "playwright": "^1.48.0"
  },
  "peerDependenciesMeta": {},
  "engines": {
    "node": ">=20"
  }
}
